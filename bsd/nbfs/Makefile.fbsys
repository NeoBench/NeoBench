# NBFS -- NeoBench File System kernel module.
#
# This Makefile is for use inside the FreeBSD source tree.
# It is auto-generated by bsd/configure-neobench.sh from
# bsd/nbfs/Makefile in the NeoBench tree.
#
# When building outside the FreeBSD source tree, use the
# parent Makefile instead.

.SUFFIXES: .c .o

SYSDIR ?= ../../..
SRCS    = nbfs_mount.c \
          nbfs_vnops.c \
          nbfs_node.c \
          nbfs_io.c \
          nbfs_crc32.c

KMOD    = nbfs

.include <bsd.kmod.mk>
