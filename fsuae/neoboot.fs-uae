[config]

# NeoBench floppy-boot dev config: Kickstart runs the ADF bootblock, which
# probes the on-board IDE controller and streams the kernel flat image from
# the raw IDE hardfile into Zorro III RAM (0x40000000), then jumps to it.

amiga_model = A4000

cpu = 68060

kickstart_file = /home/lordp/Documents/FS-UAE/Kickstarts/A4000.47.115.rom

chip_memory = 2048
fast_memory = 0
zorro_iii_memory = 256

floppy_drive_count = 1
floppy_drive_0 = /home/lordp/NeoBench/images/neoboot.adf

hard_drive_0 = /home/lordp/NeoBench/images/neobench-raw.hdf
hard_drive_0_type = hdf
hard_drive_0_controller = ide
hard_drive_0_label = NEObench

fullscreen = 0
window_width = 1024
window_height = 768

serial_port = tcp://127.0.0.1:1234/wait

save_states = 0
