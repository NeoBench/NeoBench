/*
 * NeoBench Bare-Metal Amiga Kernel
 * RTG (Retargetable Graphics) Driver
 *
 * Supports Picasso II, Picasso IV, CyberVision 64 via Zorro II/III bus.
 * Provides chunky-pixel linear framebuffer for high-res output.
 */

#include "../include/neobench.h"
#include "../include/types.h"
#include "custom.h"

namespace neo {
namespace rtg {

/* ========================================================================
 * Zorro Autoconfig Definitions
 * ======================================================================== */

/* Autoconfig space starts at 0xE80000 for Zorro II */
static constexpr uint32_t AUTOCONFIG_BASE   = 0xE80000;

/* Zorro III config space */
static constexpr uint32_t ZORRO3_CONFIG_BASE = 0xFF000000;

/* Autoconfig register offsets (nibble-wide, at even addresses) */
static constexpr uint32_t AC_PRODUCT_HI     = 0x00;  /* er_Type: bits 7-4 = type, 3-0 = product hi */
static constexpr uint32_t AC_PRODUCT_LO     = 0x02;  /* product ID low nibble + flags */
static constexpr uint32_t AC_FLAGS          = 0x04;
static constexpr uint32_t AC_RESERVED       = 0x06;
static constexpr uint32_t AC_MFG_HI        = 0x08;
static constexpr uint32_t AC_MFG_LO_HI     = 0x0A;
static constexpr uint32_t AC_MFG_LO        = 0x0C;
static constexpr uint32_t AC_MFG_LO_LO     = 0x0E;
static constexpr uint32_t AC_SERIAL_0       = 0x10;
static constexpr uint32_t AC_SERIAL_1       = 0x14;
static constexpr uint32_t AC_SERIAL_2       = 0x18;
static constexpr uint32_t AC_SERIAL_3       = 0x1C;
static constexpr uint32_t AC_SHUTUP         = 0x4C;

/* Known RTG card IDs */
static constexpr uint16_t MFG_VILLAGE_TRONIC = 0x07DA;
static constexpr uint16_t MFG_PHASE5         = 0x07DC;

static constexpr uint8_t PROD_PICASSO_II     = 0x0B;
static constexpr uint8_t PROD_PICASSO_IV     = 0x15;
static constexpr uint8_t PROD_CYBERVISION64  = 0x22;

/* ========================================================================
 * Card Types
 * ======================================================================== */

enum RTGCardType {
    RTG_NONE = 0,
    RTG_PICASSO_II,
    RTG_PICASSO_IV,
    RTG_CYBERVISION64
};

struct RTGCard {
    RTGCardType type;
    uint32_t    board_base;     /* Mapped board base address */
    uint32_t    fb_base;        /* Framebuffer base address */
    uint32_t    fb_size;        /* Framebuffer size in bytes */
    uint32_t    io_base;        /* I/O register base */
    uint16_t    width;
    uint16_t    height;
    uint8_t     bpp;            /* Bits per pixel (8 or 16) */
    uint32_t    pitch;          /* Bytes per scanline */
    const char *name;
};

/* ========================================================================
 * State
 * ======================================================================== */

static RTGCard card;
static int cursor_x;
static int cursor_y;
static int text_cols;
static int text_rows;

/* Reference to the ECS 8x8 font */
namespace ecs {
    extern const uint8_t *get_font(void);
}
static const uint8_t *font_data;

static constexpr int FONT_WIDTH  = 8;
static constexpr int FONT_HEIGHT = 8;

/* ========================================================================
 * Zorro Autoconfig Probing
 *
 * Reads nibble-wide autoconfig registers to identify boards.
 * Each board appears at 0xE80000 and must be configured (assigned
 * a base address) before the next board becomes visible.
 * ======================================================================== */

static uint8_t ac_read_nibble(uint32_t base, uint32_t offset)
{
    volatile uint8_t *addr = (volatile uint8_t *)(base + offset);
    return (~(*addr)) >> 4;  /* Autoconfig data is active-low, upper nibble */
}

static uint16_t ac_read_manufacturer(uint32_t base)
{
    uint16_t mfg = 0;
    mfg |= (uint16_t)(ac_read_nibble(base, 0x10) & 0x0F) << 12;
    mfg |= (uint16_t)(ac_read_nibble(base, 0x12) & 0x0F) << 8;
    mfg |= (uint16_t)(ac_read_nibble(base, 0x14) & 0x0F) << 4;
    mfg |= (uint16_t)(ac_read_nibble(base, 0x16) & 0x0F);
    return mfg;
}

static uint8_t ac_read_product(uint32_t base)
{
    uint8_t prod = 0;
    prod |= (ac_read_nibble(base, 0x00) & 0x0F) << 4;  /* Type register has product hi */
    prod |= (ac_read_nibble(base, 0x02) & 0x0F);
    return prod;
}

static uint32_t ac_read_board_size(uint32_t base)
{
    uint8_t type = ac_read_nibble(base, 0x00);
    uint8_t size_bits = ac_read_nibble(base, 0x04) & 0x07;

    /* Zorro II board sizes */
    static const uint32_t z2_sizes[] = {
        8 * 1024 * 1024,    /* 000: 8MB */
        64 * 1024,          /* 001: 64K */
        128 * 1024,         /* 010: 128K */
        256 * 1024,         /* 011: 256K */
        512 * 1024,         /* 100: 512K */
        1024 * 1024,        /* 101: 1MB */
        2 * 1024 * 1024,    /* 110: 2MB */
        4 * 1024 * 1024     /* 111: 4MB */
    };

    (void)type;
    return z2_sizes[size_bits & 0x07];
}

/* Write base address to autoconfig to "claim" the board */
static void ac_configure_board(uint32_t config_base, uint32_t board_addr)
{
    volatile uint8_t *base_hi  = (volatile uint8_t *)(config_base + 0x48);
    volatile uint8_t *base_lo  = (volatile uint8_t *)(config_base + 0x4A);

    *base_hi = (uint8_t)(board_addr >> 24);
    *base_lo = (uint8_t)(board_addr >> 16);
}

/* Shut up (disable) a board we don't want */
static void ac_shutup(uint32_t config_base)
{
    volatile uint8_t *shutup = (volatile uint8_t *)(config_base + AC_SHUTUP);
    *shutup = 0;
}

/* ========================================================================
 * Card-Specific Initialization
 * ======================================================================== */

/* Cirrus Logic GD5426/GD5428 (Picasso II) register programming */
static bool init_picasso_ii(void)
{
    volatile uint8_t *io = (volatile uint8_t *)card.io_base;

    /* Program CL-GD5426 for 640x480 @ 8bpp */
    /* Sequencer registers */
    io[0x3C4] = 0x00; io[0x3C5] = 0x01;  /* Reset */
    io[0x3C4] = 0x00; io[0x3C5] = 0x03;  /* Release reset */

    /* Set 8bpp packed pixel mode */
    io[0x3C4] = 0x07; io[0x3C5] = 0x01;  /* Extended sequencer: 8bpp */

    /* CRTC timing for 640x480 */
    io[0x3D4] = 0x00; io[0x3D5] = 0x5F;  /* H total */
    io[0x3D4] = 0x01; io[0x3D5] = 0x4F;  /* H display end */
    io[0x3D4] = 0x02; io[0x3D5] = 0x50;  /* H blank start */
    io[0x3D4] = 0x03; io[0x3D5] = 0x82;  /* H blank end */
    io[0x3D4] = 0x04; io[0x3D5] = 0x54;  /* H sync start */
    io[0x3D4] = 0x05; io[0x3D5] = 0x80;  /* H sync end */
    io[0x3D4] = 0x06; io[0x3D5] = 0x0B;  /* V total */
    io[0x3D4] = 0x07; io[0x3D5] = 0x3E;  /* Overflow */
    io[0x3D4] = 0x10; io[0x3D5] = 0xEA;  /* V sync start */
    io[0x3D4] = 0x11; io[0x3D5] = 0x8C;  /* V sync end */
    io[0x3D4] = 0x12; io[0x3D5] = 0xDF;  /* V display end */
    io[0x3D4] = 0x15; io[0x3D5] = 0xE7;  /* V blank start */
    io[0x3D4] = 0x16; io[0x3D5] = 0x04;  /* V blank end */

    /* Set pitch (offset) */
    io[0x3D4] = 0x13; io[0x3D5] = 0x50;  /* 640/8 = 80 (pitch in units of 8) */

    /* Set linear framebuffer offset to 0 */
    io[0x3D4] = 0x0C; io[0x3D5] = 0x00;  /* Start address hi */
    io[0x3D4] = 0x0D; io[0x3D5] = 0x00;  /* Start address lo */

    card.name = "Picasso II (CL-GD5426)";
    return true;
}

static bool init_picasso_iv(void)
{
    volatile uint8_t *io = (volatile uint8_t *)card.io_base;

    /* Picasso IV uses CL-GD5446 - similar programming model */
    io[0x3C4] = 0x00; io[0x3C5] = 0x01;
    io[0x3C4] = 0x00; io[0x3C5] = 0x03;

    /* 8bpp mode */
    io[0x3C4] = 0x07; io[0x3C5] = 0x01;

    /* CRTC for 800x600 */
    io[0x3D4] = 0x00; io[0x3D5] = 0x7F;  /* H total */
    io[0x3D4] = 0x01; io[0x3D5] = 0x63;  /* H display end */
    io[0x3D4] = 0x02; io[0x3D5] = 0x64;  /* H blank start */
    io[0x3D4] = 0x03; io[0x3D5] = 0x82;  /* H blank end */
    io[0x3D4] = 0x04; io[0x3D5] = 0x6B;  /* H sync start */
    io[0x3D4] = 0x05; io[0x3D5] = 0x1B;  /* H sync end */
    io[0x3D4] = 0x06; io[0x3D5] = 0x72;  /* V total */
    io[0x3D4] = 0x07; io[0x3D5] = 0xF0;  /* Overflow */
    io[0x3D4] = 0x10; io[0x3D5] = 0x58;  /* V sync start */
    io[0x3D4] = 0x11; io[0x3D5] = 0x8C;  /* V sync end */
    io[0x3D4] = 0x12; io[0x3D5] = 0x57;  /* V display end */
    io[0x3D4] = 0x15; io[0x3D5] = 0x58;  /* V blank start */
    io[0x3D4] = 0x16; io[0x3D5] = 0x72;  /* V blank end */

    io[0x3D4] = 0x13; io[0x3D5] = 0x64;  /* 800/8 = 100 */

    card.width  = 800;
    card.height = 600;
    card.pitch  = 800;
    card.name   = "Picasso IV (CL-GD5446)";
    return true;
}

static bool init_cybervision64(void)
{
    /* CyberVision 64 uses S3 Trio64 chipset */
    volatile uint8_t *io = (volatile uint8_t *)card.io_base;

    /* Unlock S3 registers */
    io[0x3D4] = 0x38; io[0x3D5] = 0x48;  /* Unlock CR38 */
    io[0x3D4] = 0x39; io[0x3D5] = 0xA5;  /* Unlock CR39 */

    /* Set 8bpp linear mode */
    io[0x3D4] = 0x31; io[0x3D5] = 0x08;  /* Memory config: enhanced mode */
    io[0x3D4] = 0x50; io[0x3D5] = 0x00;  /* Extended system control 1 */
    io[0x3D4] = 0x51; io[0x3D5] = 0x00;  /* Extended system control 2 */

    /* 640x480 timing */
    io[0x3D4] = 0x00; io[0x3D5] = 0x5F;
    io[0x3D4] = 0x01; io[0x3D5] = 0x4F;
    io[0x3D4] = 0x02; io[0x3D5] = 0x50;
    io[0x3D4] = 0x03; io[0x3D5] = 0x82;
    io[0x3D4] = 0x04; io[0x3D5] = 0x54;
    io[0x3D4] = 0x05; io[0x3D5] = 0x80;
    io[0x3D4] = 0x06; io[0x3D5] = 0x0B;
    io[0x3D4] = 0x07; io[0x3D5] = 0x3E;
    io[0x3D4] = 0x10; io[0x3D5] = 0xEA;
    io[0x3D4] = 0x11; io[0x3D5] = 0x8C;
    io[0x3D4] = 0x12; io[0x3D5] = 0xDF;

    io[0x3D4] = 0x13; io[0x3D5] = 0x50;

    /* Enable linear framebuffer */
    io[0x3D4] = 0x58; io[0x3D5] = 0x13;  /* Linear addr window control */

    card.name = "CyberVision 64 (S3 Trio64)";
    return true;
}

/* ========================================================================
 * Public API
 * ======================================================================== */

bool probe_rtg(void)
{
    card.type = RTG_NONE;

    /* Scan Zorro II autoconfig space for known RTG cards */
    /* In a real bare-metal scenario, we iterate autoconfig boards.
     * Here we check for boards at the standard autoconfig address. */

    volatile uint8_t *ac = (volatile uint8_t *)AUTOCONFIG_BASE;

    /* Check if any board is present (type nibble != 0xFF after inversion) */
    uint8_t type_nibble = ac_read_nibble(AUTOCONFIG_BASE, 0x00);
    if (type_nibble == 0x0F || type_nibble == 0x00) {
        return false;  /* No board present */
    }

    /* Read manufacturer and product IDs */
    uint16_t mfg  = ac_read_manufacturer(AUTOCONFIG_BASE);
    uint8_t  prod = ac_read_product(AUTOCONFIG_BASE);
    uint32_t board_size = ac_read_board_size(AUTOCONFIG_BASE);

    /* Match known RTG cards */
    if (mfg == MFG_VILLAGE_TRONIC && prod == PROD_PICASSO_II) {
        card.type       = RTG_PICASSO_II;
        card.fb_size    = board_size;
        card.width      = 640;
        card.height     = 480;
        card.bpp        = 8;
        card.pitch      = 640;
    } else if (mfg == MFG_VILLAGE_TRONIC && prod == PROD_PICASSO_IV) {
        card.type       = RTG_PICASSO_IV;
        card.fb_size    = board_size;
        card.width      = 800;
        card.height     = 600;
        card.bpp        = 8;
        card.pitch      = 800;
    } else if (mfg == MFG_PHASE5 && prod == PROD_CYBERVISION64) {
        card.type       = RTG_CYBERVISION64;
        card.fb_size    = board_size;
        card.width      = 640;
        card.height     = 480;
        card.bpp        = 8;
        card.pitch      = 640;
    } else {
        /* Unknown board - shut it up and return */
        ac_shutup(AUTOCONFIG_BASE);
        return false;
    }

    /* Configure the board: assign it a base address in Zorro space */
    /* For Zorro II: boards go in 0x200000-0x9FFFFF range */
    uint32_t board_addr = 0x200000;  /* Simplified - real code would track allocations */
    ac_configure_board(AUTOCONFIG_BASE, board_addr);

    card.board_base = board_addr;
    card.fb_base    = board_addr;              /* Framebuffer at start of board memory */
    card.io_base    = board_addr + 0x400000;   /* I/O registers offset varies by card */

    return true;
}

bool init_rtg(void)
{
    if (card.type == RTG_NONE) {
        if (!probe_rtg()) return false;
    }

    font_data = ecs::get_font();
    text_cols = card.width / FONT_WIDTH;
    text_rows = card.height / FONT_HEIGHT;
    cursor_x  = 0;
    cursor_y  = 0;

    /* Initialize the specific card */
    bool ok = false;
    switch (card.type) {
        case RTG_PICASSO_II:    ok = init_picasso_ii();    break;
        case RTG_PICASSO_IV:    ok = init_picasso_iv();    break;
        case RTG_CYBERVISION64: ok = init_cybervision64(); break;
        default: return false;
    }

    if (!ok) return false;

    /* Clear framebuffer */
    clear_rtg();

    /* Set default palette (8bpp mode) */
    if (card.bpp == 8) {
        volatile uint8_t *io = (volatile uint8_t *)card.io_base;
        io[0x3C8] = 0;  /* Start writing at palette index 0 */

        /* Color 0: dark background */
        io[0x3C9] = 0x02; io[0x3C9] = 0x02; io[0x3C9] = 0x08;
        /* Color 1: bright text */
        io[0x3C9] = 0x38; io[0x3C9] = 0x38; io[0x3C9] = 0x38;
        /* Color 2: cyan */
        io[0x3C9] = 0x10; io[0x3C9] = 0x28; io[0x3C9] = 0x30;
        /* Color 3: green */
        io[0x3C9] = 0x00; io[0x3C9] = 0x38; io[0x3C9] = 0x18;
    }

    return true;
}

void clear_rtg(void)
{
    volatile uint8_t *fb = (volatile uint8_t *)card.fb_base;
    uint32_t fb_total = card.pitch * card.height;

    for (uint32_t i = 0; i < fb_total; i++) {
        fb[i] = 0;
    }

    cursor_x = 0;
    cursor_y = 0;
}

void putchar_rtg(char c)
{
    if (c == '\n') {
        cursor_x = 0;
        cursor_y++;
    } else if (c == '\r') {
        cursor_x = 0;
    } else if (c == '\t') {
        cursor_x = (cursor_x + 8) & ~7;
    } else {
        /* Render character into chunky framebuffer */
        if (c < 32 || c > 126) c = 32;

        const uint8_t *glyph = font_data + ((c - 32) * FONT_HEIGHT);
        volatile uint8_t *fb = (volatile uint8_t *)card.fb_base;

        for (int y = 0; y < FONT_HEIGHT; y++) {
            uint8_t bits = glyph[y];
            uint32_t row_offset = (uint32_t)(cursor_y * FONT_HEIGHT + y) * card.pitch;
            uint32_t col_offset = (uint32_t)(cursor_x * FONT_WIDTH);

            for (int x = 0; x < FONT_WIDTH; x++) {
                uint8_t pixel = (bits & (0x80 >> x)) ? 1 : 0;
                fb[row_offset + col_offset + x] = pixel;
            }
        }

        cursor_x++;
    }

    if (cursor_x >= text_cols) {
        cursor_x = 0;
        cursor_y++;
    }

    if (cursor_y >= text_rows) {
        scroll_rtg();
        cursor_y = text_rows - 1;
    }
}

void puts_rtg(const char *str)
{
    while (*str) {
        putchar_rtg(*str++);
    }
}

void scroll_rtg(void)
{
    volatile uint8_t *fb = (volatile uint8_t *)card.fb_base;
    uint32_t row_bytes = FONT_HEIGHT * card.pitch;
    uint32_t total = card.pitch * card.height;

    /* Scroll up by one text row */
    for (uint32_t i = 0; i < total - row_bytes; i++) {
        fb[i] = fb[i + row_bytes];
    }

    /* Clear last row */
    for (uint32_t i = total - row_bytes; i < total; i++) {
        fb[i] = 0;
    }
}

void set_color_rtg(int index, uint8_t r, uint8_t g, uint8_t b)
{
    if (card.bpp != 8) return;

    volatile uint8_t *io = (volatile uint8_t *)card.io_base;
    io[0x3C8] = (uint8_t)index;
    io[0x3C9] = r >> 2;  /* VGA DAC uses 6-bit values */
    io[0x3C9] = g >> 2;
    io[0x3C9] = b >> 2;
}

const char *get_card_name(void)
{
    return card.name;
}

RTGCardType get_card_type(void)
{
    return card.type;
}

int get_cols(void)   { return text_cols; }
int get_rows(void)   { return text_rows; }
void set_cursor(int x, int y) { cursor_x = x; cursor_y = y; }

} /* namespace rtg */
} /* namespace neo */
