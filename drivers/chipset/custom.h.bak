#define ADKCON              0x09E

/* ========================================================================
 * DMA Control Bits
 * ======================================================================== */

#define DMAF_SETCLR         0x8000
#define DMAF_AUD0           0x0001
#define DMAF_AUD1           0x0002
#define DMAF_AUD2           0x0004
#define DMAF_AUD3           0x0008
#define DMAF_AUDIO          0x000F
#define DMAF_DISK           0x0010
#define DMAF_SPRITE         0x0020
#define DMAF_BLITTER        0x0040
#define DMAF_COPPER         0x0080
#define DMAF_RASTER         0x0100
#define DMAF_MASTER          0x0200
#define DMAF_BLITHOG        0x0400
#define DMAF_ALL            0x03FF

/* ========================================================================
 * Interrupt Bits
 * ======================================================================== */

#define INTF_SETCLR         0x8000
#define INTF_TBE            0x0001  /* Serial transmit buffer empty */
#define INTF_DSKBLK         0x0002  /* Disk block done */
#define INTF_SOFTINT        0x0004  /* Software interrupt */
#define INTF_PORTS          0x0008  /* CIA-A (keyboard, etc) */
#define INTF_COPER          0x0010  /* Copper */
#define INTF_VERTB          0x0020  /* Vertical blank */
#define INTF_BLIT           0x0040  /* Blitter done */
#define INTF_AUD0           0x0080  /* Audio ch 0 */
#define INTF_AUD1           0x0100
#define INTF_AUD2           0x0200
#define INTF_AUD3           0x0400
#define INTF_RBF            0x0800  /* Serial receive buffer full */
#define INTF_DSKSYN         0x1000  /* Disk sync */
#define INTF_EXTER          0x2000  /* CIA-B (disk, serial) */
#define INTF_INTEN          0x4000  /* Master interrupt enable */

/* ========================================================================
 * BPLCON0 Bits
 * ======================================================================== */

#define BPLCON0_HIRES       0x8000
#define BPLCON0_BPU2        0x4000
#define BPLCON0_BPU1        0x2000
#define BPLCON0_BPU0        0x1000
#define BPLCON0_HAM         0x0800
#define BPLCON0_DPF         0x0400  /* Dual playfield */
#define BPLCON0_COLOR       0x0200  /* Composite color enable */
#define BPLCON0_GAUD        0x0100  /* Genlock audio */
#define BPLCON0_UHRES       0x0080  /* Ultra-hires (AGA) */
#define BPLCON0_SHRES       0x0040  /* Super-hires (AGA) */
#define BPLCON0_BYPASS      0x0020
#define BPLCON0_BPU3        0x0010  /* AGA 8th bitplane */
#define BPLCON0_LPEN        0x0008
#define BPLCON0_LACE        0x0004
#define BPLCON0_ERSY        0x0002
#define BPLCON0_ECSENA      0x0001

/* ========================================================================
 * Display Mode Constants
 * ======================================================================== */

#define DISPMODE_LORES      0x0000
#define DISPMODE_HIRES      0x8000
#define DISPMODE_SUPERHIRES 0x0040  /* SHRES bit in BPLCON0 */
#define DISPMODE_HAM6       0x0800  /* HAM + 6 bitplanes */
#define DISPMODE_HAM8       0x0810  /* HAM + 8 bitplanes (AGA) */
#define DISPMODE_EHB        0x0080  /* Extra half-brite */
#define DISPMODE_LACE       0x0004
#define DISPMODE_DPF        0x0400  /* Dual playfield */

/* PAL vs NTSC */
#define PAL_LINES           312
#define NTSC_LINES          262
#define PAL_VFREQ           50
#define NTSC_VFREQ          60

/* ========================================================================
 * Inline Hardware Access Functions
 * ======================================================================== */

static inline void custom_write(uint16_t reg, uint16_t value)
{
    *((volatile uint16_t *)(CUSTOM_BASE + reg)) = value;
}

static inline uint16_t custom_read(uint16_t reg)
{
    return *((volatile uint16_t *)(CUSTOM_BASE + reg));
}

static inline void custom_write32(uint16_t reg, uint32_t value)
{
    volatile uint16_t *ptr = (volatile uint16_t *)(CUSTOM_BASE + reg);
    ptr[0] = (uint16_t)(value >> 16);
    ptr[1] = (uint16_t)(value & 0xFFFF);
}

/* ========================================================================
 * Blitter Wait
 * ======================================================================== */

static inline void wait_blit(void)
{
    /* Read DMACONR - bit 14 is BBUSY */
    while (custom_read(DMACONR) & (1 << 14)) {
        /* busy-wait */
    }
}

/* ========================================================================
 * VBlank Wait
 * ======================================================================== */

static inline void wait_vblank(void)
{
    /* Wait until we leave vblank region first */
    while ((custom_read(VPOSR) & 0x0001) && (custom_read(VHPOSR) >> 8) >= 300) {
        /* in vblank, wait to leave */
    }
    /* Now wait for vertical position to reach line 300+ (PAL vblank start ~line 312) */
    while (!((custom_read(VPOSR) & 0x0001) || (custom_read(VHPOSR) >> 8) >= 300)) {
        /* wait for vblank */
    }
}

/* Simple version: wait for INTREQR VERTB flag */
static inline void wait_vblank_int(void)
{
    custom_write(INTREQ, INTF_VERTB);  /* clear pending */
    while (!(custom_read(INTREQR) & INTF_VERTB)) {
        /* wait */
    }
}

/* ========================================================================
 * Copper Instruction Macros
 *
 * Copper instructions are 32 bits (2 words):
 *   MOVE: first word = register address, second word = data
 *   WAIT: first word = VP.HP with bit 0 = 0, second word = mask with bit 0 = 1
 * ======================================================================== */

/* CMOVE: Write value to a custom chip register via Copper */
#define CMOVE(reg, val)     (uint32_t)(((uint32_t)(reg) << 16) | (uint32_t)(val))

/* CWAIT: Wait for beam to reach (vpos, hpos) */
#define CWAIT(vpos, hpos)   (uint32_t)((((uint32_t)(vpos) & 0xFF) << 24) | \
                             (((uint32_t)(hpos) & 0xFE) << 16) | \
                             0x0001FFFE)

/* CWAIT with mask */
#define CWAIT_MASK(vpos, hpos, vmask, hmask) \
    (uint32_t)((((uint32_t)(vpos) & 0xFF) << 24) | \
               (((uint32_t)(hpos) & 0xFE) << 16) | \
               (((uint32_t)(vmask) & 0x7F) << 8) | \
               ((uint32_t)(hmask) & 0xFE) | 0x0001)

/* CEND: End of Copper list (wait for impossible position) */
#define CEND                (uint32_t)0xFFFFFFFE

/* Helper to split a 32-bit Copper instruction into two 16-bit words */
#define COP_WORD1(inst)     ((uint16_t)((inst) >> 16))
#define COP_WORD2(inst)     ((uint16_t)((inst) & 0xFFFF))

/* Write a MOVE instruction into a copper list array */
static inline void cop_move(uint16_t *list, int *pos, uint16_t reg, uint16_t val)
{
    list[(*pos)++] = reg;
    list[(*pos)++] = val;
}

/* Write a WAIT instruction into a copper list array */
static inline void cop_wait(uint16_t *list, int *pos, uint8_t vpos, uint8_t hpos)
{
    list[(*pos)++] = ((uint16_t)vpos << 8) | ((uint16_t)(hpos & 0xFE)) | 0x0001;
    list[(*pos)++] = 0xFFFE;
}

/* Write end-of-list */
static inline void cop_end(uint16_t *list, int *pos)
{
    list[(*pos)++] = 0xFFFF;
    list[(*pos)++] = 0xFFFE;
}

/* ========================================================================
 * Sprite DMA Helpers
 * ======================================================================== */

static inline void sprite_set_ptr(int sprite_num, uint32_t address)
{
    uint16_t reg = SPR0PTH + (sprite_num * 4);
    custom_write(reg,     (uint16_t)(address >> 16));
    custom_write(reg + 2, (uint16_t)(address & 0xFFFF));
}

/* Disable all sprites by pointing them at a null sprite structure */
static inline void sprites_off(uint32_t null_sprite_addr)
{
    for (int i = 0; i < 8; i++) {
        sprite_set_ptr(i, null_sprite_addr);
    }
}

/* ========================================================================
 * Color Register Helpers
 * ======================================================================== */

/* OCS/ECS: 12-bit color (4 bits per component) */
static inline uint16_t rgb4(uint8_t r, uint8_t g, uint8_t b)
{
    return ((uint16_t)(r & 0x0F) << 8) |
           ((uint16_t)(g & 0x0F) << 4) |
           ((uint16_t)(b & 0x0F));
}

/* Set an OCS/ECS color register (0-31) */
static inline void set_color_ocs(int index, uint8_t r4, uint8_t g4, uint8_t b4)
{
    custom_write(COLOR00 + (index * 2), rgb4(r4, g4, b4));
}

/* AGA: 24-bit color via bank switching
 * BPLCON3 bits 13-15 select the color bank (0-7, each bank = 32 colors)
 * To set the low nibbles, write with LOCT bit (bit 9 of BPLCON3) set
 */
static inline void set_color_aga(int index, uint8_t r8, uint8_t g8, uint8_t b8)
{
    int bank = (index >> 5) & 0x07;
    int reg_index = index & 0x1F;
    uint16_t reg_offset = COLOR00 + (reg_index * 2);

    /* Select color bank - upper nibbles first */
    uint16_t bplcon3_base = custom_read(BPLCON3) & 0x003F;  /* preserve low bits */

    /* Write upper 4 bits of each component */
    custom_write(BPLCON3, (uint16_t)(bank << 13) | bplcon3_base);
    custom_write(reg_offset, rgb4(r8 >> 4, g8 >> 4, b8 >> 4));

    /* Write lower 4 bits via LOCT (bit 9) */
    custom_write(BPLCON3, (uint16_t)(bank << 13) | bplcon3_base | 0x0200);
    custom_write(reg_offset, rgb4(r8 & 0x0F, g8 & 0x0F, b8 & 0x0F));

    /* Restore BPLCON3 */
    custom_write(BPLCON3, bplcon3_base);
}

/* ========================================================================
 * Bitplane Pointer Helpers
 * ======================================================================== */

static inline void set_bpl_ptr(int plane, uint32_t address)
{
    uint16_t reg = BPL1PTH + (plane * 4);
    custom_write(reg,     (uint16_t)(address >> 16));
    custom_write(reg + 2, (uint16_t)(address & 0xFFFF));
}

/* Write bitplane pointers into a copper list */
static inline void cop_set_bpl_ptrs(uint16_t *list, int *pos,
                                     uint32_t *plane_ptrs, int num_planes)
{
    for (int i = 0; i < num_planes; i++) {
        uint16_t reg = BPL1PTH + (i * 4);
        cop_move(list, pos, reg,     (uint16_t)(plane_ptrs[i] >> 16));
        cop_move(list, pos, reg + 2, (uint16_t)(plane_ptrs[i] & 0xFFFF));
    }
}

/* ========================================================================
 * Chipset Detection
 * ======================================================================== */

enum ChipsetType {
    CHIPSET_OCS     = 0,
    CHIPSET_ECS     = 1,
    CHIPSET_AGA     = 2
};

static inline ChipsetType detect_agnus(void)
{
    uint16_t vposr = custom_read(VPOSR);
    uint8_t agnus_id = (vposr >> 8) & 0x7F;

    if (agnus_id >= 0x20) {
        return CHIPSET_AGA;  /* Alice */
    } else if (agnus_id >= 0x10) {
        return CHIPSET_ECS;  /* Fat Agnus / Super Agnus */
    }
    return CHIPSET_OCS;  /* Thin/Fat Agnus (original) */
}

static inline ChipsetType detect_denise(void)
{
    uint16_t denise = custom_read(DENISEID);

    if (denise == 0x00F8) {
        return CHIPSET_AGA;  /* Lisa */
    } else if (denise == 0x00FC) {
        return CHIPSET_ECS;  /* Super Denise */
    }
    return CHIPSET_OCS;  /* Denise (8362) */
}

static inline bool is_pal(void)
{
    return (custom_read(VPOSR) & 0x1000) != 0;
}

#endif /* NEOBENCH_CUSTOM_H */
